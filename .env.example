# ============================================================
# Copiá este archivo a .env.local y completá los valores.
#
# .env.local está en .gitignore. ESTE archivo NO: nunca pongas
# acá una clave real, solo el hueco donde va.
# ============================================================

# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://tuproyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio. Solo servidor: salta RLS entera.
# Se usa para los webhooks de pago y el resumen semanal.
SUPABASE_SERVICE_ROLE_KEY=

# ---- OpenAI (audio, foto y texto con IA) ----
# NUNCA lleva NEXT_PUBLIC_: esta clave vive solo en el servidor.
OPENAI_API_KEY=

# ---- Opcional: elegir modelos ----
# MODELO_IA=gpt-4o-mini
# MODELO_AUDIO=whisper-1

# ---- Avisos push (npx web-push generate-vapid-keys) ----
NEXT_PUBLIC_VAPID_PUBLICA=
VAPID_PRIVADA=
VAPID_CONTACTO=mailto:hola@tudominio.com

# ---- Resumen semanal por email (resend.com) ----
RESEND_API_KEY=
EMAIL_REMITENTE=Orden <hola@tudominio.com>

# ---- Cobro ----
# Pasarela activa: 'ninguna' | 'pagopar' | 'stripe'
PASARELA=ninguna
# Secreto compartido que valida los webhooks de pago y las tareas programadas.
WEBHOOK_SECRETO=
CRON_SECRETO=

# Pagopar (Paraguay)
PAGOPAR_PUBLICO=
PAGOPAR_PRIVADO=

# Stripe (resto del mundo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRECIO_MENSUAL=
STRIPE_PRECIO_ANUAL=

# ---- Bancard vPOS 2.0 (tarjeta, QR y PIX, en guaraníes) ----
# Las claves salen del portal comercios.bancard.com.py → Claves, y son
# distintas en Staging y en Producción. Solo servidor: NUNCA con NEXT_PUBLIC_.
# Sin BANCARD_ENTORNO (o con otro valor) Bancard queda apagado para todos.
BANCARD_ENTORNO=                 # staging | produccion
BANCARD_CLAVE_PUBLICA=           # 32 letras y números
BANCARD_CLAVE_PRIVADA=           # 40 letras y números; firma cada pedido, nunca viaja en plano
# Interruptor general: 1 abre «Pagar con tarjeta o QR» a todos los dueños.
# En staging se ignora: mientras tanto lo ven la administración y las cuentas
# habilitadas desde /admin.
BANCARD_ABIERTO=
# Opcionales: 0 para no pedir 3D Secure en el cobro con tarjeta guardada;
# 1 para que los textos digan «tarjeta, QR o PIX»; 2 para hablar con Bancard
# por HTTP/2 si «Probar conexión» (/admin) dice «Bloqueo» (su protección
# rechaza el HTTP/1.1 de Node en algunos entornos).
BANCARD_3DS=
NEXT_PUBLIC_BANCARD_PIX=
BANCARD_HTTP=

# ---- URL pública del sitio (para links de vuelta del pago y emails) ----
NEXT_PUBLIC_SITIO=http://localhost:3000

# Cada cuanto corre el recordatorio: "diario" (Vercel Hobby) o "cada-hora" (Vercel Pro).
CRON_RECORDATORIO=diario

# ---- Soporte (aparece en Ajustes; si estan vacios, la seccion no se muestra) ----
NEXT_PUBLIC_WHATSAPP_SOPORTE=
NEXT_PUBLIC_EMAIL_SOPORTE=
